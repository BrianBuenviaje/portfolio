# EmailJS settings for the message form (dashboard.emailjs.com). Optional: the form already sends with
# the identifiers in src/data/content.js. Set these only to point a build at a different EmailJS
# account: in .env.local for local work, or on Vercel under Project > Settings > Environment Variables.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
